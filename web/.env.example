# Copy to web/.env.local and fill in. All three are PUBLIC browser values:
# the project URL, the publishable (anon) key, and the Edge Function URL. They
# are safe to expose client-side — the anon key is SELECT-only via RLS and the
# function is the only writer (service-role key, server-side). Real secrets
# (the service-role key) live in the Supabase/Vercel dashboards, never here.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
NEXT_PUBLIC_PROCESS_UPLOAD_URL=https://your-project-ref.supabase.co/functions/v1/process-upload
