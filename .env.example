# =============================================================================
# .env.example — checked-in template. Copy to .env.local and fill in.
# Never commit the filled-in file. Secrets belong in .env.local (git-ignored)
# and, for deploys, in the Vercel / Supabase dashboards.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase project — from Dashboard > Project Settings > API
# -----------------------------------------------------------------------------

# Public REST/Realtime URL, e.g. https://abcdefghijkl.supabase.co
# Safe to expose to the browser (hence NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Anon (public) key. Safe in the browser. Read access is governed by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NOTE: the service-role key is deliberately NOT listed here.
# The Edge Function reads SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY from the
# runtime environment, which Supabase injects automatically for deployed and
# locally-served functions. Do not hardcode it, do not add it to this template,
# and do not put it in NEXT_PUBLIC_* — it bypasses RLS and must never reach the
# browser or a commit.

# -----------------------------------------------------------------------------
# Supabase CLI — for linking and deploying migrations/functions
# -----------------------------------------------------------------------------

# Project ref (the subdomain in the URL above, e.g. abcdefghijkl).
# Used by `supabase link --project-ref ...` and function deploys.
SUPABASE_PROJECT_REF=your-project-ref

# The Postgres database password is prompted for interactively by the CLI
# (`supabase link` / `supabase db push`). It is not read from this file, so it
# is intentionally omitted here. Keep it in your own password manager.

# -----------------------------------------------------------------------------
# Web app (Next.js) — where the upload page POSTs the CSV
# -----------------------------------------------------------------------------

# Full URL of the deployed process-upload Edge Function, e.g.
# https://YOUR-PROJECT-REF.supabase.co/functions/v1/process-upload
NEXT_PUBLIC_PROCESS_UPLOAD_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1/process-upload
